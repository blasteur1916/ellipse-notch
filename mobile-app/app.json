{
  "expo": {
    "name": "Ellipse",
    "slug": "ellipse",
    "scheme": "ellipse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ellipse.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Ellipse se connecte à votre PC sur le Wi-Fi pour échanger des fichiers."
      }
    },
    "android": {
      "package": "app.ellipse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ellipse utilise l’appareil photo pour scanner le QR code d’appairage affiché sur votre PC.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ellipse accède à vos photos pour les envoyer sur votre PC."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ellipse enregistre dans vos photos les images reçues du PC.",
          "savePhotosPermission": "Ellipse enregistre dans vos photos les images reçues du PC."
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
